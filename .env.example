# Autodarts Cloud OAuth 2.0 / OIDC Configuration
# Obtain your Client ID from Autodarts Developer Portal or Client settings
VITE_AUTODARTS_CLIENT_ID=
VITE_AUTODARTS_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_AUTODARTS_API_URL=/api/autodarts

# Local Board Manager WebSocket & REST (defaults to local port 3180)
VITE_BOARD_MANAGER_WS=ws://127.0.0.1:3180/api/events
VITE_BOARD_MANAGER_HTTP=http://127.0.0.1:3180/api/state

# Default Mode: "local" | "demo" | "cloud"
VITE_DEFAULT_DATA_MODE=local
